# MCP Skeleton Server - Environment Configuration
#
# Copy this file to `.env` and adjust the values for your environment:
#
#   cp .env.example .env        # Linux / macOS
#   copy .env.example .env      # Windows
#
# `.env` is git-ignored on purpose - never commit it.
# The stdio entry point (`mcp-server.php`) loads `.env` only when it exists,
# so the skeleton also runs without one.

# --- Database ------------------------------------------------------------
#
# Naming scheme: DB_<server>_<key>. The <server> segment is lowercased and
# becomes the connection name: a server named `default` is registered as
# `Flight::db()`, any other name as `Flight::db_<server>()`.
#
# Database wiring ships DISABLED: `Database::loadEnvConfig()` and
# `Database::configureAll()` are commented out in `app/config/config.php`.
# Uncomment them there before these variables have any effect.

# MySQL
# DB_default_dsn=mysql:dbname=test;host=127.0.0.1;port=3306
# DB_default_user=root
# DB_default_password=
# DB_default_options=

# SQL Server
# DB_reporting_dsn=sqlsrv:Server=localhost,1433;Database=reporting
# DB_reporting_user=sa
# DB_reporting_password=
# DB_reporting_options=encrypt=true;trustServerCertificate=false;connectionPooling=true

# --- Application ---------------------------------------------------------
#
# MCP_SERVER_NAME and MCP_SERVER_VERSION are reported to clients in the
# initialize handshake, as serverInfo. MCP_SERVER_INSTRUCTIONS is optional
# guidance shown to the model; omit it to leave the field out entirely.

DEBUG=true
MCP_SERVER_NAME="FlightPHP MCP Skeleton"
MCP_SERVER_VERSION=1.0.0
# MCP_SERVER_INSTRUCTIONS="Use this server to ..."

# --- HTTP transport -------------------------------------------------------

# Origins accepted on the MCP endpoint, comma-separated. Validating Origin is
# required by the spec to prevent DNS rebinding attacks. Any port on a listed
# host is accepted. Use "*" only if you understand the risk.
# MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Server-Sent Events on GET /mcp. Disabled by default: the built-in PHP server
# (`composer start`) handles one request at a time and cannot fork on Windows,
# so an open stream would make the server unresponsive. With this off, GET /mcp
# answers 405, which the spec explicitly allows. Turn it on only behind
# Apache/nginx with php-fpm.
# MCP_HTTP_SSE=false

# Upper bound in seconds for a single SSE stream; 0 means unbounded.
# MCP_HTTP_SSE_MAX_SECONDS=0
